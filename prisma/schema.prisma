generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Existing tables (owned by main app) ──────────────────────────────────────

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  phone              String?         @unique
  password           String?
  city               String?
  state              String?
  pincode            String?
  address            String?
  dob                DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  googleAccessToken  String?
  googleRefreshToken String?
  isAdmin            Boolean         @default(false)
  AccountType        AccountType[]
  Email              Email[]
  NetworthEntry      NetworthEntry[]
  SyncedDay          SyncedDay[]
}

model Email {
  id             String   @id @default(cuid())
  userId         String
  gmailMessageId String   @unique
  sender         String?
  subject        String?
  snippet        String?
  body           String?
  receivedAt     DateTime
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([receivedAt])
  @@index([userId])
}

model AccountType {
  id          String        @id @default(cuid())
  userId      String
  type        String
  AccountName AccountName[]
  User        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model AccountName {
  id            String      @id @default(cuid())
  accountTypeId String
  name          String
  AccountType   AccountType @relation(fields: [accountTypeId], references: [id], onDelete: Cascade)

  @@unique([accountTypeId, name])
}

model NetworthEntry {
  id           String   @id @default(cuid())
  userId       String
  accountType  String
  accountName  String
  balance      Float
  snapshotDate DateTime
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id])
}

model SyncedDay {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ── New tables (owned by this service) ───────────────────────────────────────

model Transaction {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email_id             String    @unique
  user_id              String
  transaction_id       String?
  amount               Decimal?  @db.Decimal(15, 2)
  type                 String?   @db.VarChar(10)
  platform             String?   @db.VarChar(100)
  merchant             String?
  currency             String    @default("INR")
  category             String?   @db.VarChar(100)
  account_type         String?   @db.VarChar(100)
  account_number       String?   @db.VarChar(50)
  account_name         String?   @db.VarChar(100)
  transaction_date     DateTime? @db.Date
  transaction_time     DateTime? @db.Time(0)
  description          String?
  raw_subject          String?
  is_transaction_email Boolean   @default(false)
  confidence           Decimal?  @db.Decimal(3, 2)
  created_at           DateTime  @default(now())

  @@index([user_id])
  @@map("transactions")
}

model Account {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String
  account_type        String?   @db.VarChar(100)
  account_number      String?   @db.VarChar(50)
  account_name        String?   @db.VarChar(100)
  last_transaction_at DateTime?
  created_at          DateTime  @default(now())

  @@unique([user_id, account_number, account_name])
  @@map("accounts")
}
