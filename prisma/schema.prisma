generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?   @unique
  password            String?
  googleAccessToken   String?
  googleRefreshToken  String?
  isAdmin             Boolean  @default(false)
  city      String?
  state     String?
  pincode   String?
  address   String?
  dob       DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // RELATIONS
  accountTypes    AccountType[]
  networthEntries NetworthEntry[]
  emails          Email[]
  syncedDays      SyncedDay[]
  transactions    Transaction[]
}

model Email {
  id             String   @id @default(cuid())
  userId         String
  gmailMessageId String   @unique
  sender         String?
  subject        String?
  snippet        String?
  body           String?
  receivedAt     DateTime
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction  Transaction?

  @@index([userId])
  @@index([receivedAt])
}

model AccountType {
  id           String        @id @default(cuid())
  userId       String
  type         String
  accountNames AccountName[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type]) // unique per user
}

model AccountName {
  id            String @id @default(cuid())
  accountTypeId String
  name          String

  accountType AccountType @relation(fields: [accountTypeId], references: [id], onDelete: Cascade)

  @@unique([accountTypeId, name])
}

model SyncedDay {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Transaction {
  id                  String    @id @default(uuid()) @db.Uuid
  emailId             String    @unique @map("email_id")
  userId              String    @map("user_id")
  transactionId       String?   @map("transaction_id")
  amount              Decimal?  @db.Decimal(15, 2)
  type                String?   @db.VarChar(10)
  platform            String?   @db.VarChar(100)
  category            String?   @db.VarChar(100)
  accountType         String?   @map("account_type") @db.VarChar(100)
  accountNumber       String?   @map("account_number") @db.VarChar(50)
  accountName         String?   @map("account_name") @db.VarChar(100)
  transactionDate     DateTime? @map("transaction_date") @db.Date
  transactionTime     DateTime? @map("transaction_time") @db.Time(0)
  description         String?
  rawSubject          String?   @map("raw_subject")
  isTransactionEmail  Boolean   @default(false) @map("is_transaction_email")
  confidence          Decimal?  @db.Decimal(3, 2)
  createdAt           DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

model NetworthEntry {
  id           String   @id @default(cuid())
  userId       String
  accountType  String
  accountName  String
  balance      Float
  snapshotDate DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
